#:import dp kivy.metrics.dp

<ManualControlScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(32)
        spacing: dp(16)

        MDCard:
            orientation: "vertical"
            padding: dp(24)
            spacing: dp(16)
            elevation: 4
            radius: [dp(12)]
            theme_bg_color: "Custom"
            md_bg_color: app.apply_alpha(app.theme_cls.primaryColor, 0.12)

            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: dp(60)
                spacing: dp(16)

                MDLabel:
                    text: "⚠️"
                    font_style: "Display"
                    role: "small"
                    size_hint_x: None
                    width: dp(60)
                    halign: "center"

                MDLabel:
                    text: "Manual Control - Advanced Users Only"
                    font_style: "Headline"
                    role: "small"
                    bold: True

            MDLabel:
                text: "IMPORTANT: Using the Jubilee web UI for manual control will:\n\n• Invalidate the current automation system state\n• Require system recalibration after use\n• Potentially interrupt any running jobs\n• Move hardware outside of tracked positions\n\nOnly use manual control if you understand the Jubilee system and can manually verify positions afterward.\n\nAfter using manual control, you must:\n1. Return to Settings\n2. Disconnect and reconnect the system\n3. Verify all positions are correct"
                theme_text_color: "Primary"
                size_hint_y: None
                height: dp(360)

        MDButton:
            style: "filled"
            on_release: root.confirm_open_web_ui()
            size_hint: None, None
            size: dp(250), dp(56)
            pos_hint: {"center_x": 0.5}
            MDButtonText:
                text: "Open Jubilee Web UI"
