#:import dp kivy.metrics.dp

<MoldWidget>:
    size_hint: None, None
    size: dp(42), dp(42)
    canvas:
        Color:
            rgba: app.theme_cls.primaryColor if self.selected else app.apply_alpha(app.theme_cls.onSurfaceColor, 0.25)
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: app.apply_alpha(app.theme_cls.onSurfaceColor, 0.6)
        Line:
            ellipse: (self.x, self.y, self.width, self.height)
            width: 1.5

<BedVisualization>:
    orientation: "vertical"
    spacing: dp(8)

    MDBoxLayout:
        size_hint_y: None
        height: dp(24)
        spacing: dp(6)

        Widget:
            size_hint_x: None
            width: dp(24)

        MDBoxLayout:
            id: col_buttons
            spacing: dp(6)

    MDBoxLayout:
        orientation: "horizontal"
        spacing: dp(6)

        MDBoxLayout:
            id: row_buttons
            orientation: "vertical"
            size_hint_x: None
            width: dp(24)
            spacing: dp(6)

        MDAnchorLayout:
            anchor_x: "center"
            anchor_y: "center"

            MDGridLayout:
                id: molds_grid
                cols: root.cols
                rows: root.rows
                spacing: dp(12)
                size_hint: None, None
                width: self.minimum_width
                height: self.minimum_height
                row_force_default: True
                col_force_default: True
                row_default_height: dp(42)
                col_default_width: dp(42)

<PowderDispensingScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(16)

        MDCard:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(88)
            padding: dp(12)
            spacing: dp(8)
            elevation: 2
            radius: [dp(8)]

            MDButton:
                style: "elevated"
                on_release: root.select_all_wells()
                size_hint_x: 0.25
                size_hint_y: None
                height: dp(48)
                MDButtonText:
                    text: "Select All"

            MDButton:
                style: "text"
                on_release: root.clear_selection()
                size_hint_x: 0.25
                size_hint_y: None
                height: dp(48)
                MDButtonText:
                    text: "Clear"

            MDButton:
                style: "filled"
                on_release: root.show_weight_dialog()
                size_hint_x: 0.25
                size_hint_y: None
                height: dp(48)
                MDButtonText:
                    text: "Set Weights"

            MDButton:
                style: "filled"
                on_release: root.start_job()
                size_hint_x: 0.25
                size_hint_y: None
                height: dp(48)
                MDButtonText:
                    text: "Start Job"

        MDCard:
            size_hint_y: 1
            elevation: 4
            radius: [dp(12)]
            padding: dp(16)

            BedVisualization:
                id: bed_viz
                size_hint: 1, 1

        MDLabel:
            id: status_label
            text: "Select wells and configure weights to begin"
            halign: "center"
            theme_text_color: "Secondary"
            size_hint_y: None
            height: dp(40)
