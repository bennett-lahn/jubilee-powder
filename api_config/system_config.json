{
    "paths": {
        "job_files_dir": "frontend/api/files"
    },
    "safety": {
        "max_weight_per_well": 10.0,
        "weight_tolerance": 0.005
    },
    "server": {
        "cors_origins": ["http://localhost:5173"],
        "mock_hardware": false
    },
    "machine": {
        "duet_ip": "192.168.1.2",
        "default_feedrate": 2800,
        "tamper_travel_position": 30,
        "scale_port": "/dev/ttyUSB0",
        "num_dispensers": 2,
        "pistons_per_dispenser": 2
    },
    "tools": {
        "manipulator": {
            "index": 0,
            "name": "manipulator"
        },
        "shore_a_hardness_tester": {
            "index": 1,
            "name": "shore_a_hardness_tester"
        },
        "shore_d_hardness_tester": {
            "index": 2,
            "name": "shore_d_hardness_tester"
        }
    },
    "manipulator": {
        "tamper_axis": "V",
        "tamp_depth_min": 0.0,
        "tamp_depth_max": 14.0,
        "tamp_speed_min": 500,
        "tamp_speed_max": 5000,
        "tamp_depth_default": 14.0,
        "tamp_speed_default": 500
    },
    "hardness_testing": {
        "enable_monotonic_drop_check": false
    },
    "powder_dispenser_cover": {
        "servo": "S1",
        "open_angle": 90,
        "closed_angle": 70
    },
    "google_drive": {
        "enabled": false,
        "credentials_file": "api_config/service_account.json",
        "drive_folder_id": "",
        "retry_interval_seconds": 60
    }
}
