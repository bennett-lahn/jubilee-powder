        },
        "shore_a_hardness_tester": {
            "index": 1,
            "name": "shore_a_hardness_tester"
        },
        "shore_d_hardness_tester": {
            "index": 2,
            "name": "shore_d_hardness_tester"
        }
    },
    "manipulator": {
