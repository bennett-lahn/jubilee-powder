#:import dp kivy.metrics.dp

<DataScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(16)

        MDCard:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(80)
            padding: dp(16)
            spacing: dp(16)
            elevation: 2
            radius: [dp(8)]

            MDLabel:
                text: "Data Browser"
                font_style: "Title"
                role: "large"
                size_hint_x: 0.7

            MDButton:
                style: "filled"
                on_release: root.open_data_folder()
                size_hint_x: 0.3
                MDButtonText:
                    text: "Open Folder"

        MDCard:
            orientation: "vertical"
            padding: dp(16)
            elevation: 4
            radius: [dp(12)]

            MDLabel:
                id: info_label
                text: "Data Directory:"
                theme_text_color: "Secondary"
                size_hint_y: None
                height: dp(40)

            MDScrollView:
                MDList:
                    id: file_list
                    size_hint_y: None
                    height: self.minimum_height

        MDButton:
            style: "text"
            on_release: root.refresh_file_list()
            size_hint_y: None
            height: dp(48)
            MDButtonText:
                text: "Refresh"
