[Unit]
Description=Jubilee Automation Backend
# network.target is reliable on all Raspberry Pi OS versions.
# network-online.target is intentionally avoided - it requires extra systemd
# services to be enabled (NetworkManager-wait-online / systemd-networkd-wait-online)
# and silently blocks boot on Raspberry Pi OS if those are not active.
# The backend's own hardware connect logic handles retries if the Duet is not
# yet reachable at startup.
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/jubilee-powder
ExecStart=/home/%i/jubilee-powder/.venv/bin/uvicorn \
    frontend.server:app \
    --host 0.0.0.0 \
    --port 8000
# Restart=always covers both crash exits and clean exits (e.g. import errors)
Restart=always
RestartSec=5
# Hard cap so a broken service does not spam restarts indefinitely
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
